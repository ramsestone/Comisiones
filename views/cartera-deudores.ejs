<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/bill-icon.svg">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cartera de Deudores — Asesores y Gerentes</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;900&family=Space+Mono:wght@700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/styles/layout.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:       #0f1e1e;
      --surface:  #162828;
      --border:   rgba(96,230,26,0.15);
      --border-md:rgba(96,230,26,0.3);
      --text-1:   #ffffff;
      --text-2:   #8fada0;
      --text-3:   rgba(143,173,160,0.55);
      --accent:   #7af028;
      --green-bg: rgba(96,230,26,0.15);
      --green-tx: #7af028;
      --green-br: rgba(96,230,26,0.35);
      --amber-bg: rgba(240,165,0,0.12);
      --amber-tx: #f0a500;
      --amber-br: rgba(240,165,0,0.3);
      --red-bg:   rgba(231,76,60,0.12);
      --red-tx:   #e74c3c;
      --red-br:   rgba(231,76,60,0.3);
      --blue-bg:  rgba(56,197,245,0.12);
      --blue-tx:  #38c5f5;
      --blue-br:  rgba(56,197,245,0.3);
      --gray-bg:  rgba(143,173,160,0.08);
      --gray-tx:  #8fada0;
      --gray-br:  rgba(143,173,160,0.25);
      --radius:   10px;
      --radius-sm:6px;

      /* Variables mapeadas para la cartera */
      --color-bg: var(--bg);
      --color-surface: var(--surface);
      --color-surface-2: rgba(255,255,255,0.03);
      --color-text: var(--text-1);
      --color-text-muted: var(--text-2);
      --color-text-faint: var(--text-3);
      --color-border: var(--border);
      --color-border-strong: var(--border-md);
      
      --color-danger: var(--red-tx);
      --color-danger-bg: var(--red-bg);
      --color-danger-border: var(--red-br);
      
      --color-success: var(--green-tx);
      --color-success-bg: var(--green-bg);
      --color-success-border: var(--green-br);
      
      --color-amber: var(--amber-tx);
      --color-amber-bg: var(--amber-bg);
      
      --color-info: var(--blue-tx);
      --color-info-bg: var(--blue-bg);
      --color-info-border: var(--blue-br);
      
      --radius-md: var(--radius-sm);
      --radius-lg: var(--radius);
      --font: 'Nunito', sans-serif;
    }
    body {
      font-family: var(--font);
      background: var(--color-bg);
      color: var(--color-text);
      font-size: 14px;
      min-height: 100vh;
    }
    
    .main-area { background: var(--bg); }
    .app-header { background: rgba(15,30,30,0.98); }

    .page { width: 90%; max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem; }

    /* Header */
    .page-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1.75rem; }
    .page-title { font-size: 20px; font-weight: 600; color: var(--color-text); }
    .page-subtitle { font-size: 13px; color: var(--color-text-muted); margin-top: 3px; }
    .page-date { font-size: 12px; color: var(--color-text-faint); text-align: right; margin-top: 4px; }

    /* Stats row */
    .stats-row { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 10px; margin-bottom: 1.5rem; }
    .stat { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 12px 14px; position: relative; }
    .stat-label { font-size: 12px; color: var(--color-text-muted); margin-bottom: 4px; }
    .stat-value { font-size: 20px; font-weight: 600; color: var(--color-text); }
    .stat-value.danger { color: var(--color-danger); }
    .stat-value.success { color: var(--color-success); }

    /* Stat Clickable (Desglose) */
    .stat-clickable {
      cursor: pointer;
      user-select: none;
      transition: transform .15s, border-color .15s, box-shadow .15s;
    }
    .stat-clickable:hover {
      transform: translateY(-2px);
      border-color: var(--color-danger);
      box-shadow: 0 4px 18px rgba(231,76,60,0.18);
    }
    .stat-clickable.active {
      border-color: var(--color-danger);
      background: linear-gradient(180deg, var(--color-surface), rgba(231,76,60,0.06));
    }
    .stat-header-flex {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      margin-bottom: 4px;
    }
    .stat-badge-btn {
      font-size: 10px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 999px;
      background: var(--color-danger-bg);
      color: var(--color-danger);
      border: 1px solid var(--color-danger-border);
      display: inline-flex;
      align-items: center;
      gap: 3px;
      transition: all .15s;
    }
    .stat-clickable:hover .stat-badge-btn, .stat-clickable.active .stat-badge-btn {
      background: var(--color-danger);
      color: #ffffff;
    }

    /* Breakdown Toggle Button in Filter Bar */
    .btn-toggle-ubi {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-danger-border);
      background: var(--color-danger-bg);
      color: var(--color-danger);
      cursor: pointer;
      font-family: var(--font);
      transition: all .15s;
      white-space: nowrap;
    }
    .btn-toggle-ubi:hover, .btn-toggle-ubi.active {
      background: var(--color-danger);
      color: #ffffff;
      box-shadow: 0 2px 10px rgba(231,76,60,0.3);
    }
    .ubi-count-pill {
      background: rgba(0,0,0,0.25);
      font-size: 11px;
      padding: 1px 6px;
      border-radius: 10px;
    }

    /* Breakdown Section Panel */
    .ubi-breakdown-section {
      background: linear-gradient(145deg, rgba(22,40,40,0.95), rgba(15,30,30,0.98));
      border: 1px solid rgba(231,76,60,0.35);
      border-radius: var(--radius-lg);
      padding: 1.25rem 1.4rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 8px 28px rgba(0,0,0,0.3);
      backdrop-filter: blur(10px);
      animation: fadeInUbi .2s ease-out;
    }
    @keyframes fadeInUbi {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .ubi-panel-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 1rem;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid var(--color-border);
    }
    .ubi-panel-title-area {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .ubi-icon-box {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-md);
      background: var(--color-danger-bg);
      border: 1px solid var(--color-danger-border);
      color: var(--color-danger);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 19px;
    }
    .ubi-panel-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--color-text);
    }
    .ubi-panel-sub {
      font-size: 12px;
      color: var(--color-text-muted);
    }

    /* Segmented Tabs */
    .ubi-tabs {
      display: flex;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 3px;
      gap: 3px;
    }
    .ubi-tab-btn {
      background: transparent;
      border: none;
      color: var(--color-text-muted);
      font-size: 12px;
      font-weight: 600;
      padding: 6px 13px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      font-family: var(--font);
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all .15s;
    }
    .ubi-tab-btn:hover {
      color: var(--color-text);
    }
    .ubi-tab-btn.active {
      background: var(--color-danger);
      color: #ffffff;
      box-shadow: 0 1px 4px rgba(0,0,0,0.25);
    }

    .ubi-close-btn {
      background: transparent;
      border: 1px solid var(--color-border);
      color: var(--color-text-faint);
      font-size: 16px;
      cursor: pointer;
      padding: 6px 9px;
      border-radius: var(--radius-sm);
      line-height: 1;
      transition: all .15s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .ubi-close-btn:hover {
      color: var(--color-text);
      border-color: var(--color-border-strong);
      background: var(--color-surface-2);
    }

    /* Mini KPIs inside Breakdown */
    .ubi-kpis {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-bottom: 1.1rem;
    }
    .ubi-kpi-item {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 8px 12px;
    }
    .ubi-kpi-lbl {
      font-size: 11px;
      color: var(--color-text-muted);
      margin-bottom: 2px;
    }
    .ubi-kpi-val {
      font-size: 17px;
      font-weight: 700;
      color: var(--color-text);
    }
    .ubi-kpi-val.red { color: var(--color-danger); }

    /* Search in breakdown */
    .ubi-search-box {
      display: flex;
      align-items: center;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 7px 11px;
      margin-bottom: 1rem;
      gap: 8px;
    }
    .ubi-search-box i { color: var(--color-text-muted); font-size: 14px; }
    .ubi-search-box input {
      flex: 1;
      background: transparent;
      border: none;
      color: var(--color-text);
      font-family: var(--font);
      outline: none;
      font-size: 13px;
    }
    .ubi-search-box input::placeholder { color: var(--color-text-faint); }

    /* Grid of breakdown items */
    .ubi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 12px;
      max-height: 500px;
      overflow-y: auto;
      padding-right: 4px;
    }
    .ubi-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 13px 15px;
      display: flex;
      flex-direction: column;
      gap: 9px;
      transition: border-color .15s, transform .15s, box-shadow .15s;
      position: relative;
    }
    .ubi-card:hover {
      border-color: rgba(231,76,60,0.45);
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(0,0,0,0.25);
    }
    .ubi-card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }
    .ubi-dev-badge {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .05em;
      padding: 2px 7px;
      border-radius: 4px;
      background: var(--blue-bg);
      color: var(--blue-tx);
      border: 1px solid var(--blue-br);
    }
    .ubi-pct-badge {
      font-size: 11px;
      font-weight: 700;
      color: var(--color-danger);
    }
    .ubi-name {
      font-size: 15px;
      font-weight: 700;
      color: #ffffff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ubi-amt-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }
    .ubi-amt {
      font-size: 19px;
      font-weight: 700;
      color: var(--color-danger);
      font-family: 'Space Mono', monospace;
    }
    .ubi-type-pill {
      font-size: 10px;
      color: var(--color-text-muted);
      background: var(--color-surface-2);
      padding: 2px 6px;
      border-radius: 4px;
    }
    .ubi-bar-bg {
      width: 100%;
      height: 6px;
      background: rgba(255,255,255,0.06);
      border-radius: 999px;
      overflow: hidden;
    }
    .ubi-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #e74c3c, #f0a500);
      border-radius: 999px;
      transition: width .3s ease;
    }
    .ubi-debtors-list {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 2px;
      font-size: 11px;
    }
    .ubi-debtor-tag {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: 4px;
      padding: 2px 6px;
      color: var(--color-text-muted);
      display: inline-flex;
      align-items: center;
      gap: 3px;
    }
    .ubi-debtor-tag strong {
      color: var(--color-text);
    }
    .ubi-filter-action {
      margin-top: 4px;
      display: flex;
      justify-content: flex-end;
    }
    .btn-ubi-filter {
      background: transparent;
      border: 1px solid var(--color-border);
      border-radius: 4px;
      color: var(--color-text-muted);
      font-size: 11px;
      font-weight: 600;
      padding: 4px 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: all .12s;
    }
    .btn-ubi-filter:hover {
      background: var(--color-surface-2);
      color: var(--accent);
      border-color: var(--green-br);
    }

    /* Active filter indicator banner */
    .filter-indicator-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--color-danger-bg);
      border: 1px solid var(--color-danger-border);
      border-radius: var(--radius-md);
      padding: 9px 14px;
      margin-bottom: 1.25rem;
      font-size: 13px;
      color: var(--color-text);
      animation: fadeInUbi .15s ease-out;
    }
    .filter-indicator-bar strong { color: var(--color-danger); }

    /* Debtor cards */
    .debtor-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); margin-bottom: 10px; overflow: hidden; transition: border-color .15s; }
    .debtor-card.expanded { border-color: var(--color-border-strong); }
    .debtor-main { display: flex; align-items: center; gap: 12px; padding: 14px 16px; cursor: pointer; user-select: none; }
    .debtor-main:hover { background: var(--color-surface-2); }

    /* Avatar */
    .avatar { width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; flex-shrink: 0; }
    .av-a { background: var(--blue-bg); color: var(--blue-tx); }
    .av-b { background: var(--green-bg); color: var(--green-tx); }
    .av-c { background: var(--amber-bg); color: var(--amber-tx); }
    .av-d { background: var(--red-bg); color: var(--red-tx); }
    .av-e { background: var(--gray-bg); color: var(--gray-tx); }

    .debtor-info { flex: 1; min-width: 0; }
    .debtor-name { font-size: 14px; font-weight: 600; }
    .debtor-role { font-size: 12px; color: var(--color-text-muted); }
    .badges { display: flex; gap: 6px; margin-top: 5px; flex-wrap: wrap; }
    .badge { font-size: 11px; padding: 2px 8px; border-radius: 999px; font-weight: 600; display: inline-flex; align-items: center; gap: 3px; border: 1px solid transparent; }
    .badge i { font-size: 12px; }
    .badge-deu { background: var(--color-danger-bg); color: var(--color-danger); border-color: var(--color-danger-border); }
    .badge-com { background: var(--color-success-bg); color: var(--color-success); border-color: var(--color-success-border); }
    .badge-sal { background: var(--color-info-bg); color: var(--color-info); border-color: var(--color-info-border); }
    .badge-none { background: var(--color-surface-2); color: var(--color-text-faint); border-color: var(--color-border); }

    .debtor-amounts { text-align: right; flex-shrink: 0; }
    .amount-label { font-size: 11px; color: var(--color-text-muted); }
    .amount-val { font-size: 15px; font-weight: 600; }
    .amount-val.red { color: var(--color-danger); }
    .amount-val.green { color: var(--color-success); }
    .chevron { font-size: 18px; color: var(--color-text-faint); transition: transform .2s; margin-left: 8px; flex-shrink: 0; }
    .expanded .chevron { transform: rotate(180deg); }

    /* Panel */
    .debtor-panel { border-top: 1px solid var(--color-border); padding: 14px 16px; display: none; }
    .debtor-panel.open { display: block; }
    .panel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
    .panel-box { background: var(--color-surface-2); border-radius: var(--radius-md); padding: 10px 12px; border: 1px solid var(--color-border); }
    .panel-box-label { font-size: 11px; color: var(--color-text-muted); margin-bottom: 3px; }
    .panel-box-val { font-size: 15px; font-weight: 600; color: var(--color-text); }
    .panel-box-val.green { color: var(--color-success); }
    .panel-box-val.red { color: var(--color-danger); }

    /* Adjustment section */
    .adj-section { border-top: 1px solid var(--color-border); padding-top: 12px; margin-top: 2px; }
    .adj-title { font-size: 11px; font-weight: 600; color: var(--color-text-muted); margin-bottom: 10px; text-transform: uppercase; letter-spacing: .06em; }
    .adj-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .adj-row label { font-size: 13px; color: var(--color-text); flex: 1; display: flex; align-items: center; gap: 5px; }
    .adj-row label i { font-size: 15px; color: var(--color-text-muted); }
    .adj-row input[type=number] {
      width: 120px; font-size: 13px;
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-md);
      padding: 6px 9px;
      background: var(--color-surface);
      color: var(--color-text);
      font-family: var(--font);
      outline: none;
    }
    .adj-row input[type=number]:focus { border-color: var(--color-info); }
    .btn-adj {
      font-size: 12px; padding: 6px 13px;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border-strong);
      background: var(--color-surface);
      color: var(--color-text);
      cursor: pointer;
      display: inline-flex; align-items: center; gap: 4px;
      font-family: var(--font);
      transition: background .12s, border-color .12s;
      white-space: nowrap;
      font-weight: 600;
    }
    .btn-adj:hover { background: var(--color-surface-2); }
    .btn-adj.danger { border-color: var(--color-danger-border); color: var(--color-danger); }
    .btn-adj.danger:hover { background: var(--color-danger-bg); }
    .btn-adj.success { border-color: var(--color-success-border); color: var(--color-success); }
    .btn-adj.success:hover { background: var(--color-success-bg); }
    .adj-avail { font-size: 11px; color: var(--color-text-faint); margin-top: 4px; }
    .adj-avail strong { color: var(--color-text-muted); }
    .disabled-msg { font-size: 12px; color: var(--color-text-faint); font-style: italic; padding: 6px 0; display: flex; align-items: center; gap: 6px; }

    /* Log */
    .log-list { margin-top: 12px; border-top: 1px solid var(--color-border); padding-top: 10px; max-height: 140px; overflow-y: auto; }
    .log-item { display: flex; justify-content: space-between; align-items: center; font-size: 12px; padding: 4px 0; color: var(--color-text-muted); border-bottom: 1px solid var(--color-border); gap: 8px; }
    .log-item:last-child { border-bottom: none; }
    .log-type { font-weight: 600; white-space: nowrap; }
    .log-type.red { color: var(--color-danger); }
    .log-type.green { color: var(--color-success); }
    .log-type.amber { color: var(--color-amber); }
    .log-desc { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .log-monto { white-space: nowrap; font-weight: 600; color: var(--color-text); }
    .log-fecha { white-space: nowrap; color: var(--color-text-faint); }

    /* Toast */
    #toast {
      position: fixed;
      bottom: 1.5rem; right: 1.5rem;
      background: #1c3030; color: #fff;
      border: 1px solid rgba(96,230,26,0.3);
      font-size: 13px;
      padding: 10px 16px;
      border-radius: var(--radius-sm);
      opacity: 0; pointer-events: none;
      transition: opacity .2s;
      z-index: 999; max-width: 280px;
    }
    #toast.show { opacity: 1; }

    /* Search Bar & Filters */
    .filter-bar {
      display: flex; gap: 10px; flex-wrap: wrap; align-items: center;
      margin-bottom: 1.5rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 10px 14px;
    }
    .search-container { margin-bottom: 0; display: flex; align-items: center; background: transparent; border: none; padding: 0; }
    .search-container i { color: var(--color-text-muted); font-size: 16px; margin-right: 10px; }
    .search-container input { flex: 1; background: transparent; border: none; color: var(--color-text); font-family: var(--font); outline: none; font-size: 14px; }
    .search-container input::placeholder { color: var(--color-text-faint); }

    .filter-select {
      padding: 8px 12px;
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-md);
      font-size: 13px;
      font-family: var(--font);
      color: var(--blue-tx);
      background: var(--blue-bg);
      outline: none;
      cursor: pointer;
      transition: all .15s;
      min-width: 170px;
    }
    .filter-select:hover, .filter-select:focus {
      border-color: var(--blue-tx);
      background: var(--color-surface);
      color: var(--color-text);
    }
    .filter-select option {
      background: var(--color-surface);
      color: var(--color-text);
    }

    .filter-clear {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 12px; font-weight: 600; padding: 8px 13px;
      border-radius: var(--radius-md);
      border: 1px solid var(--red-br);
      background: var(--red-bg);
      color: var(--red-tx);
      cursor: pointer;
      font-family: var(--font);
      transition: opacity .15s;
      white-space: nowrap;
    }
    .filter-clear:hover { opacity: .85; }
    .filter-clear.hidden { display: none; }

    /* ── Starfield + Beam + Dots ── */
    .stars { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
    .star  { position: absolute; border-radius: 50%; animation: twinkle var(--dur) ease-in-out infinite alternate; }
    @keyframes twinkle { from { opacity: 0.2; transform: scale(1); } to { opacity: 1; transform: scale(1.4); } }
    .beam  { position: fixed; top: 0; right: 15%; width: 260px; height: 100vh; background: linear-gradient(180deg, rgba(96,230,26,0.07) 0%, transparent 70%); transform: skewX(-8deg); pointer-events: none; z-index: 0; }

    @media (max-width: 600px) {
      .stats-row { grid-template-columns: 1fr 1fr; }
      .panel-grid { grid-template-columns: 1fr 1fr; }
      .adj-row { flex-wrap: wrap; }
      .adj-row input[type=number] { width: 100%; }
      .btn-adj { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>

<div class="stars" id="stars"></div>
<div class="beam"></div>

<%- include('partials/sidebar') %>
<div class="main-area">
<%- include('partials/header') %>

<main class="page">
  <div class="page-header">
    <div>
      <h1 class="page-title">Cartera de deudores</h1>
      <div class="page-subtitle">Asesores y gerentes · Ajustes de préstamos y cancelaciones</div>
    </div>
    <div class="page-date" id="fecha-hoy"></div>
  </div>

  <div class="stats-row">
    <div class="stat stat-clickable" id="stat-card-deuda" onclick="toggleUbiBreakdown()" title="Haz clic para ver el desglose por ubicaciones">
      <div class="stat-header-flex">
        <div class="stat-label">Total deuda activa</div>
        <span class="stat-badge-btn"><i class="ti ti-map-pin"></i> Ver desglose</span>
      </div>
      <div class="stat-value danger" id="tot-deuda">$0</div>
    </div>
    <div class="stat"><div class="stat-label">Comisiones disponibles</div><div class="stat-value success" id="tot-com">$0</div></div>
    <div class="stat"><div class="stat-label">Saldo a favor total</div><div class="stat-value success" id="tot-sal">$0</div></div>
    <div class="stat"><div class="stat-label">Saldo neto</div><div class="stat-value" id="tot-net">$0</div></div>
  </div>

  <!-- PANEL DE DESGLOSE VISUAL POR UBICACIONES -->
  <div id="ubi-breakdown-section" class="ubi-breakdown-section" style="display: none;">
    <div class="ubi-panel-top">
      <div class="ubi-panel-title-area">
        <div class="ubi-icon-box"><i class="ti ti-building-community"></i></div>
        <div>
          <div class="ubi-panel-title">Desglose de Deuda Activa por Ubicación</div>
          <div class="ubi-panel-sub">Unidades canceladas y préstamos que componen el saldo deudor (<span id="ubi-sub-total" style="color:var(--color-danger);font-weight:700;">$0</span>)</div>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
        <div class="ubi-tabs">
          <button type="button" class="ubi-tab-btn active" id="tab-ubi" onclick="setUbiTab('ubicacion')"><i class="ti ti-map-pin"></i> Ubicación</button>
          <button type="button" class="ubi-tab-btn" id="tab-des" onclick="setUbiTab('desarrollo')"><i class="ti ti-layout-grid"></i> Desarrollo</button>
          <button type="button" class="ubi-tab-btn" id="tab-tipo" onclick="setUbiTab('tipo')"><i class="ti ti-tags"></i> Tipo / Préstamos</button>
        </div>
        <button type="button" class="ubi-close-btn" onclick="toggleUbiBreakdown(false)" title="Cerrar desglose">
          <i class="ti ti-x"></i>
        </button>
      </div>
    </div>

    <!-- Mini KPIs -->
    <div class="ubi-kpis">
      <div class="ubi-kpi-item">
        <div class="ubi-kpi-lbl">Deuda Total</div>
        <div class="ubi-kpi-val red" id="ubi-kpi-total">$0</div>
      </div>
      <div class="ubi-kpi-item">
        <div class="ubi-kpi-lbl">Ubicaciones / Conceptos</div>
        <div class="ubi-kpi-val" id="ubi-kpi-count">0</div>
      </div>
      <div class="ubi-kpi-item">
        <div class="ubi-kpi-lbl">Desarrollos Involucrados</div>
        <div class="ubi-kpi-val" id="ubi-kpi-des-count">0</div>
      </div>
      <div class="ubi-kpi-item">
        <div class="ubi-kpi-lbl">Asesores con Deuda</div>
        <div class="ubi-kpi-val" id="ubi-kpi-debtors-count">0</div>
      </div>
    </div>

    <!-- Search in Breakdown -->
    <div class="ubi-search-box">
      <i class="ti ti-search"></i>
      <input type="text" id="ubi-search-input" placeholder="Buscar por nombre de ubicación, desarrollo o asesor..." oninput="renderUbiBreakdownGrid()" />
    </div>

    <!-- Grid Container -->
    <div class="ubi-grid" id="ubi-cards-grid">
      <!-- Inyectado dinámicamente -->
    </div>
  </div>

  <!-- Banner de filtro activo por ubicación -->
  <div id="ubi-filter-banner" class="filter-indicator-bar" style="display: none;">
    <div>
      <i class="ti ti-filter" style="margin-right: 6px; color: var(--color-danger);"></i>
      Filtrando cartera por: <strong id="ubi-filter-name"></strong>
    </div>
    <button type="button" class="btn-adj danger" style="padding: 4px 10px; font-size: 11px;" onclick="clearUbiFilter()">
      <i class="ti ti-x"></i> Quitar filtro
    </button>
  </div>

  <div class="filter-bar">
    <div class="search-container" style="margin-bottom:0; flex:1; min-width: 220px; border:none; padding:0; background:transparent;">
      <i class="fas fa-search" style="margin-left: 4px;"></i>
      <input type="text" id="search-user" placeholder="Buscar asesor o gerente por nombre..." oninput="filterUsers()" autocomplete="off" />
    </div>

    <button type="button" class="btn-toggle-ubi" id="btn-toggle-ubi" onclick="toggleUbiBreakdown()">
      <i class="ti ti-map-pin"></i> Desglose por Ubicaciones
      <span class="ubi-count-pill" id="ubi-btn-count">0</span>
    </button>

    <select class="filter-select" id="filter-role" onchange="filterUsers()">
      <option value="">Todos los roles</option>
      <option value="Asesor">Asesores</option>
      <option value="Gerente">Gerentes</option>
    </select>

    <select class="filter-select" id="filter-status" onchange="filterUsers()">
      <option value="">Todos los estados</option>
      <option value="with-debt">Con deuda activa</option>
      <option value="with-positive">Con saldo positivo</option>
      <option value="can-adjust">Con saldo disponible para abonar</option>
      <option value="net-negative">Con saldo neto negativo</option>
      <option value="no-movements">Sin movimientos</option>
    </select>

    <button type="button" class="filter-clear hidden" id="filter-clear" onclick="clearFilters()">
      <i class="fas fa-times"></i> Limpiar
    </button>
  </div>

  <div id="debtors-container"></div>
</main>

<div id="toast"></div>

</div><!-- /.main-area -->

<script>
  // Script dinámico de Cartera de deudores
  const fmt = n => '$' + Math.abs(n).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  let debtors = [];

  async function loadCartera(silent = false) {
    if (!silent) {
      document.getElementById('debtors-container').innerHTML = '<div class="state-msg"><div class="spinner"></div>Cargando cartera...</div>';
    }
    const currentScroll = window.scrollY;
    try {
      const r = await fetch('/api/wallet/cartera');
      const j = await r.json();
      if(j.success) {
        debtors = j.data;
        renderAll();
        recalcTotals();
        updateUbiBadge();
        if (ubiBreakdownOpen) {
          renderUbiBreakdownGrid();
        }
        if (silent) {
          window.scrollTo(0, currentScroll);
        }
      } else {
        showToast('Error: ' + j.message);
      }
    } catch(e) {
      showToast('Error al conectar con el servidor');
    }
  }

  /* ── TOTALES ── */
  function recalcTotals(sourceList = debtors) {
    let td = 0, tc = 0, ts = 0;
    sourceList.forEach(d => { td += d.deuda; tc += d.comision; ts += d.saldo; });
    document.getElementById('tot-deuda').textContent = fmt(td);
    document.getElementById('tot-com').textContent = fmt(tc);
    document.getElementById('tot-sal').textContent = fmt(ts);
    const net = (tc + ts) - td;
    const nel = document.getElementById('tot-net');
    nel.textContent = (net >= 0 ? '+' : '-') + fmt(Math.abs(net));
    nel.className = 'stat-value ' + (net >= 0 ? 'success' : 'danger');
  }

  /* ── TOAST ── */
  let toastTimer;
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 2800);
  }

  /* ── HISTORIAL ── */
  function renderLog(d) {
    if (!d.log || !d.log.length) return '<div class="disabled-msg">Sin movimientos registrados.</div>';
    return '<div class="log-list">' + d.log.map(l => `
      <div class="log-item">
        <span class="log-type ${l.tipo === 'deu' ? 'red' : l.tipo === 'pen' ? 'red' : l.tipo === 'com' ? 'green' : 'amber'}">
          ${l.tipo === 'deu' ? '− Débito' : l.tipo === 'pen' ? '+ Deuda' : l.tipo === 'com' ? '+ Comisión' : '+ Crédito'}
        </span>
        <span class="log-desc">${l.t}</span>
        <span class="log-monto">${fmt(l.monto)}</span>
        <span class="log-fecha">${l.fecha}</span>
      </div>`).join('') + '</div>';
  }

  /* ── APLICAR AJUSTE ── */
  window.applyAdj = async function(id, type, inputId) {
    if (typeof event !== 'undefined' && event && event.preventDefault) event.preventDefault();
    const d = debtors.find(x => x.id === id);
    const inp = document.getElementById(inputId);
    const val = parseFloat(inp.value);
    if (isNaN(val) || val <= 0) { showToast('Ingresa un monto válido mayor a 0'); return; }
    
    const avail = d.comision + d.saldo;
    if (avail <= 0) { showToast('Sin comisión activa ni saldo a favor para aplicar'); return; }
    if (val > avail) { showToast('El monto a abonar excede el saldo positivo disponible (' + fmt(avail) + ')'); return; }

    if (type === 'prestamo') {
      if (!d.active_debts || d.active_debts.length === 0 || d.deuda <= 0) {
        showToast('El usuario no tiene préstamos ni penalizaciones activas');
        return;
      }

      if (val > d.deuda) {
        showToast('El monto no puede ser mayor a la deuda activa (' + fmt(d.deuda) + ')');
        return;
      }
      
      const btn = typeof event !== 'undefined' && event ? event.currentTarget : null;
      let originalText = '';
      if (btn) {
        originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Aplicando...';
        btn.disabled = true;
      }

      // Pagar a la primera deuda activa (o iterar si el monto cubre más)
      const debtId = d.active_debts[0].id;

      try {
        const r = await fetch(`/api/wallet/debts/${debtId}/payment`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount: val, description: 'Descuento aplicado desde Cartera (Restar Deuda)' })
        });
        const j = await r.json();
        if(j.success) {
          showToast(`✓ Descontado ${fmt(val)} de la deuda de ${d.name}`);
          inp.value = '';
          await loadCartera(true);
        } else {
          showToast(j.message || 'Error al aplicar pago');
        }
      } catch(e) {
        showToast('Error de conexión');
      } finally {
        if (btn) {
          btn.innerHTML = originalText;
          btn.disabled = false;
        }
      }
    }
  }

  /* ── AUMENTAR DEUDA (PRÉSTAMO/CANCELACIÓN) ── */
  window.addDebt = async function(id, type, inputId) {
    if (typeof event !== 'undefined' && event && event.preventDefault) event.preventDefault();
    const d = debtors.find(x => x.id === id);
    const inp = document.getElementById(inputId);
    const val = parseFloat(inp.value);
    if (isNaN(val) || val <= 0) { showToast('Ingresa un monto válido mayor a 0'); return; }

    const btn = typeof event !== 'undefined' && event ? event.currentTarget : null;
    let originalText = '';
    if (btn) {
      originalText = btn.innerHTML;
      btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Registrando...';
      btn.disabled = true;
    }

    try {
      const r = await fetch('/api/wallet/debts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          user_id: id,
          type: type, // 'loan' o 'penalty'
          description: type === 'loan' ? 'Préstamo manual' : 'Cargo por cancelación / penalización',
          total_amount: val
        })
      });
      const j = await r.json();
      if(j.success) {
        showToast(`✓ ${type === 'loan' ? 'Préstamo' : 'Cancelación'} registrado a ${d.name}`);
        inp.value = '';
        await loadCartera(true);
      } else {
        showToast(j.message || 'Error al registrar deuda');
      }
    } catch(e) {
      showToast('Error de conexión');
    } finally {
      if (btn) {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    }
  }

  /* ── FILTRAR ── */
  let filterText = '';
  let filterRole = '';
  let filterStatus = '';

  window.filterUsers = function() {
    filterText = (document.getElementById('search-user')?.value || '').toLowerCase().trim();
    filterRole = document.getElementById('filter-role')?.value || '';
    filterStatus = document.getElementById('filter-status')?.value || '';

    updateClearBtn();
    renderAll();
  }

  function updateClearBtn() {
    const active = filterText || filterRole || filterStatus;
    const btn = document.getElementById('filter-clear');
    if (btn) btn.classList.toggle('hidden', !active);
  }

  window.clearFilters = function() {
    if (document.getElementById('search-user')) document.getElementById('search-user').value = '';
    if (document.getElementById('filter-role')) document.getElementById('filter-role').value = '';
    if (document.getElementById('filter-status')) document.getElementById('filter-status').value = '';
    filterText = '';
    filterRole = '';
    filterStatus = '';
    updateClearBtn();
    renderAll();
  }

  /* ── RENDER TARJETA ── */
  function renderCard(d) {
    const avail = d.comision + d.saldo;
    const canAdj = avail > 0;
    const neto = avail - d.deuda;

    const adjHTML = canAdj ? `
      <div class="adj-section">
        <div class="adj-title">Abonar a Deuda (usar saldo)</div>
        <div class="adj-row">
          <label><i class="ti ti-receipt-refund"></i> Restar de deuda activa</label>
          <input type="number" id="inp-pre-${d.id}" placeholder="Monto $" min="1" step="0.01" />
          <button type="button" class="btn-adj success" onclick="applyAdj('${d.id}','prestamo','inp-pre-${d.id}')">
            <i class="ti ti-minus"></i> Abonar
          </button>
        </div>
        <div class="adj-avail">
          Disponible para descuento: <strong>${fmt(avail)}</strong>
          ${d.comision > 0 ? ` &nbsp;·&nbsp; Comisión: <strong>${fmt(d.comision)}</strong>` : ''}
          ${d.saldo > 0 ? ` &nbsp;·&nbsp; Saldo a favor: <strong>${fmt(d.saldo)}</strong>` : ''}
        </div>
      </div>` :
      `<div class="adj-section">
        <div class="disabled-msg">
          <i class="ti ti-lock"></i>
          Sin comisión activa ni saldo a favor para abonar.
        </div>
      </div>`;

    const addDebtHTML = `
      <div class="adj-section" style="border-top: none; padding-top: 6px;">
        <div class="adj-title">Registrar Nueva Deuda</div>
        <div class="adj-row">
          <label><i class="ti ti-cash-banknote"></i> Dar préstamo</label>
          <input type="number" id="inp-new-pre-${d.id}" placeholder="Monto $" min="1" step="0.01" />
          <button type="button" class="btn-adj danger" onclick="addDebt('${d.id}','loan','inp-new-pre-${d.id}')">
            <i class="ti ti-plus"></i> Registrar
          </button>
        </div>
        <div class="adj-row">
          <label><i class="ti ti-file-alert"></i> Penalización / Cancelación</label>
          <input type="number" id="inp-new-can-${d.id}" placeholder="Monto $" min="1" step="0.01" />
          <button type="button" class="btn-adj danger" onclick="addDebt('${d.id}','penalty','inp-new-can-${d.id}')">
            <i class="ti ti-plus"></i> Registrar
          </button>
        </div>
      </div>
    `;

    const avatarHtml = d.picture 
      ? `<img src="${d.picture}" class="avatar" style="object-fit: cover;" alt="Avatar" />`
      : `<div class="avatar ${d.avc}">${d.av}</div>`;

    return `
    <div class="debtor-card" id="card-${d.id}">
      <div class="debtor-main" onclick="toggleCard('${d.id}')">
        ${avatarHtml}
        <div class="debtor-info">
          <div class="debtor-name">${d.name}</div>
          <div class="debtor-role">${d.role}</div>
          <div class="badges">
            ${d.deuda > 0 ? `<span class="badge badge-deu"><i class="ti ti-alert-circle"></i> Deuda: ${fmt(d.deuda)}</span>` : ''}
            ${d.comision > 0 ? `<span class="badge badge-com"><i class="ti ti-cash"></i> Comisión: ${fmt(d.comision)}</span>` : ''}
            ${d.saldo > 0 ? `<span class="badge badge-sal"><i class="ti ti-wallet"></i> Saldo a favor: ${fmt(d.saldo)}</span>` : ''}
            ${d.deuda === 0 && d.comision === 0 && d.saldo === 0 ? `<span class="badge badge-none">Sin movimientos</span>` : ''}
          </div>
        </div>
        <div class="debtor-amounts">
          <div class="amount-label">Neto</div>
          <div class="amount-val ${neto >= 0 ? 'green' : 'red'}">${neto >= 0 ? '+' : '-'}${fmt(Math.abs(neto))}</div>
        </div>
        <i class="ti ti-chevron-down chevron"></i>
      </div>
      <div class="debtor-panel" id="panel-${d.id}">
        <div class="panel-grid">
          <div class="panel-box"><div class="panel-box-label">Deuda pendiente</div><div class="panel-box-val red">${fmt(d.deuda)}</div></div>
          <div class="panel-box"><div class="panel-box-label">Comisión activa</div><div class="panel-box-val green">${fmt(d.comision)}</div></div>
          <div class="panel-box"><div class="panel-box-label">Saldo a favor</div><div class="panel-box-val green">${fmt(d.saldo)}</div></div>
          <div class="panel-box"><div class="panel-box-label">Disponible para ajuste</div><div class="panel-box-val ${canAdj ? 'green' : ''}">${fmt(avail)}</div></div>
        </div>
        ${renderDebtorUbis(d)}
        ${adjHTML}
        ${addDebtHTML}
        ${renderLog(d)}
      </div>
    </div>`;
  }

  /* ── DESGLOSE DE DEUDAS DEL ASESOR ── */
  function renderDebtorUbis(d) {
    if (d.deuda <= 0) return '';
    const ubis = extractDebtsFromDebtor(d);
    if (!ubis || !ubis.length) return '';

    return `
      <div class="adj-section" style="border-top: none; padding-top: 4px; margin-bottom: 10px;">
        <div class="adj-title" style="color: var(--color-danger); display: flex; align-items: center; justify-content: space-between;">
          <span style="display: flex; align-items: center; gap: 5px;"><i class="ti ti-map-pin"></i> Desglose de deuda activa (${fmt(d.deuda)})</span>
          <span style="font-size: 10px; color: var(--color-text-faint);">${ubis.length} concepto(s)</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 6px;">
          ${ubis.map(u => `
            <div style="display: flex; justify-content: space-between; align-items: center; background: var(--color-surface-2); border: 1px solid var(--color-border); padding: 8px 12px; border-radius: var(--radius-sm); gap: 10px;">
              <div style="min-width: 0;">
                <div style="font-weight: 700; color: #fff; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${u.location}</div>
                <div style="font-size: 11px; color: var(--color-text-muted);">${u.development} · <span style="color: var(--color-danger);">${u.type}</span></div>
              </div>
              <div style="text-align: right; flex-shrink: 0;">
                <div style="font-weight: 700; color: var(--color-danger); font-family: 'Space Mono', monospace; font-size: 14px;">${fmt(u.balance)}</div>
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }

  /* ── EXPANDIR / COLAPSAR ── */
  const expanded = new Set();
  window.toggleCard = function(id) {
    const card = document.getElementById('card-' + id);
    const panel = document.getElementById('panel-' + id);
    if (expanded.has(id)) {
      expanded.delete(id);
      card.classList.remove('expanded');
      panel.classList.remove('open');
    } else {
      expanded.add(id);
      card.classList.add('expanded');
      panel.classList.add('open');
    }
  }

  /* ── EXTRACTOR ROBUSTO DE DEUDAS ── */
  function extractDebtsFromDebtor(d) {
    const list = [];
    if (d.active_debts && d.active_debts.length > 0) {
      d.active_debts.forEach((ad, idx) => {
        let ubi = ad.location;
        let des = ad.development || 'General';
        let tipo = ad.type === 'loan' ? 'Préstamo' : 'Penalización por cancelación';
        let desc = ad.description || '';

        if (!ubi || ubi === 'Sin ubicación') {
          if (desc) {
            const match = desc.match(/cancelaci[oó]n\s*[-–:]\s*(.+)/i);
            if (match && match[1]) ubi = match[1].trim();
          }
        }

        if (!ubi || ubi === 'Sin ubicación') {
          const penLogs = (d.log || []).filter(l => l.tipo === 'pen');
          if (penLogs[idx]) {
            const match = (penLogs[idx].t || '').match(/cancelaci[oó]n\s*[-–:]\s*(.+)/i);
            if (match && match[1]) ubi = match[1].trim();
            else ubi = penLogs[idx].t;
          }
        }

        list.push({
          id: ad.id,
          balance: ad.balance || 0,
          location: ubi || (ad.type === 'loan' ? 'Préstamo personal' : 'Ubicación sin especificar'),
          development: des,
          type: tipo,
          description: desc,
          debtorName: d.name,
          debtorRole: d.role
        });
      });
    } else if (d.deuda > 0) {
      const penLogs = (d.log || []).filter(l => l.tipo === 'pen');
      if (penLogs.length > 0) {
        penLogs.forEach(l => {
          const match = (l.t || '').match(/cancelaci[oó]n\s*[-–:]\s*(.+)/i);
          list.push({
            balance: l.monto || d.deuda,
            location: match ? match[1].trim() : l.t,
            development: 'General',
            type: /prestamo/i.test(l.t || '') ? 'Préstamo' : 'Penalización por cancelación',
            description: l.t,
            debtorName: d.name,
            debtorRole: d.role
          });
        });
      } else {
        list.push({
          balance: d.deuda,
          location: 'Préstamo personal',
          development: 'General',
          type: 'Préstamo',
          description: 'Deuda activa',
          debtorName: d.name,
          debtorRole: d.role
        });
      }
    }
    return list;
  }

  function getAllActiveDebts() {
    const all = [];
    debtors.forEach(d => {
      const uDebts = extractDebtsFromDebtor(d);
      all.push(...uDebts);
    });
    return all;
  }

  /* ── CONTROLADOR DE DESGLOSE VISUAL POR UBICACIONES ── */
  let ubiBreakdownOpen = false;
  let currentUbiTab = 'ubicacion'; // 'ubicacion' | 'desarrollo' | 'tipo'
  let filterUbi = '';

  window.toggleUbiBreakdown = function(force) {
    if (typeof force === 'boolean') {
      ubiBreakdownOpen = force;
    } else {
      ubiBreakdownOpen = !ubiBreakdownOpen;
    }

    const sec = document.getElementById('ubi-breakdown-section');
    const btn = document.getElementById('btn-toggle-ubi');
    const statCard = document.getElementById('stat-card-deuda');

    if (ubiBreakdownOpen) {
      sec.style.display = 'block';
      if (btn) btn.classList.add('active');
      if (statCard) statCard.classList.add('active');
      renderUbiBreakdownGrid();
      sec.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      sec.style.display = 'none';
      if (btn) btn.classList.remove('active');
      if (statCard) statCard.classList.remove('active');
    }
  };

  window.setUbiTab = function(tab) {
    currentUbiTab = tab;
    ['tab-ubi', 'tab-des', 'tab-tipo'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.classList.remove('active');
    });
    const activeEl = document.getElementById(tab === 'ubicacion' ? 'tab-ubi' : (tab === 'desarrollo' ? 'tab-des' : 'tab-tipo'));
    if (activeEl) activeEl.classList.add('active');
    renderUbiBreakdownGrid();
  };

  function updateUbiBadge() {
    const all = getAllActiveDebts();
    const count = new Set(all.map(x => x.location)).size;
    const badge = document.getElementById('ubi-btn-count');
    if (badge) badge.textContent = count;
  }

  function renderUbiBreakdownGrid() {
    const allDebts = getAllActiveDebts();
    const q = (document.getElementById('ubi-search-input')?.value || '').toLowerCase().trim();

    // Calcular Gran Total
    let granTotal = 0;
    allDebts.forEach(x => granTotal += x.balance);

    document.getElementById('ubi-kpi-total').textContent = fmt(granTotal);
    document.getElementById('ubi-sub-total').textContent = fmt(granTotal);

    const uniqueUbis = new Set(allDebts.map(x => x.location));
    const uniqueDes = new Set(allDebts.map(x => x.development).filter(x => x && x !== 'General'));
    const uniqueDebtors = new Set(allDebts.map(x => x.debtorName));

    document.getElementById('ubi-kpi-count').textContent = uniqueUbis.size;
    document.getElementById('ubi-kpi-des-count').textContent = uniqueDes.size || (uniqueUbis.size > 0 ? 1 : 0);
    document.getElementById('ubi-kpi-debtors-count').textContent = uniqueDebtors.size;

    // Agrupaciones
    const groups = {};

    allDebts.forEach(d => {
      let key = '';
      let title = '';
      let subtitle = '';
      let badgeType = '';

      if (currentUbiTab === 'ubicacion') {
        key = d.location;
        title = d.location;
        subtitle = d.development !== 'General' ? d.development : (d.type || 'Deuda activa');
        badgeType = d.type.includes('Cancelación') ? 'Cancelación' : 'Préstamo';
      } else if (currentUbiTab === 'desarrollo') {
        key = d.development || 'General';
        title = d.development || 'General';
        subtitle = 'Desarrollo / Proyecto';
        badgeType = 'Desarrollo';
      } else {
        key = d.type.includes('Cancelación') ? 'Penalización por Cancelación' : 'Préstamo Personal';
        title = key;
        subtitle = key.includes('Cancelación') ? 'Deducciones por operaciones canceladas' : 'Créditos y adelantos otorgados';
        badgeType = key.includes('Cancelación') ? 'Cancelaciones' : 'Préstamos';
      }

      if (!groups[key]) {
        groups[key] = {
          title,
          subtitle,
          badgeType,
          total: 0,
          debtorsMap: {},
          locationsSet: new Set()
        };
      }

      groups[key].total += d.balance;
      groups[key].locationsSet.add(d.location);

      if (!groups[key].debtorsMap[d.debtorName]) {
        groups[key].debtorsMap[d.debtorName] = { amount: 0, role: d.debtorRole };
      }
      groups[key].debtorsMap[d.debtorName].amount += d.balance;
    });

    let entries = Object.values(groups);

    // Filtro por búsqueda
    if (q) {
      entries = entries.filter(g => {
        const matchTitle = g.title.toLowerCase().includes(q);
        const matchSub = g.subtitle.toLowerCase().includes(q);
        const matchDebtor = Object.keys(g.debtorsMap).some(n => n.toLowerCase().includes(q));
        const matchLoc = Array.from(g.locationsSet).some(l => l.toLowerCase().includes(q));
        return matchTitle || matchSub || matchDebtor || matchLoc;
      });
    }

    // Ordenar descendente por total
    entries.sort((a, b) => b.total - a.total);

    const grid = document.getElementById('ubi-cards-grid');
    if (entries.length === 0) {
      grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; color: var(--color-text-faint); padding: 2.5rem;"><i class="ti ti-search" style="font-size: 24px; display: block; margin-bottom: 8px;"></i>No se encontraron conceptos de deuda que coincidan con la búsqueda.</div>';
      return;
    }

    grid.innerHTML = entries.map(g => {
      const pct = granTotal > 0 ? ((g.total / granTotal) * 100) : 0;
      const debtorsList = Object.entries(g.debtorsMap).map(([name, info]) => `
        <span class="ubi-debtor-tag">
          <strong>${name}</strong> (${fmt(info.amount)})
        </span>
      `).join('');

      return `
        <div class="ubi-card">
          <div class="ubi-card-head">
            <span class="ubi-dev-badge">${g.badgeType}</span>
            <span class="ubi-pct-badge">${pct.toFixed(1)}% del total</span>
          </div>

          <div class="ubi-name" title="${g.title}">${g.title}</div>
          <div style="font-size: 11px; color: var(--color-text-muted); margin-top: -4px;">${g.subtitle}</div>

          <div class="ubi-amt-row">
            <div class="ubi-amt">${fmt(g.total)}</div>
            <div class="ubi-type-pill">${Object.keys(g.debtorsMap).length} involucrado(s)</div>
          </div>

          <div class="ubi-bar-bg">
            <div class="ubi-bar-fill" style="width: ${Math.min(100, Math.max(2, pct))}%;"></div>
          </div>

          <div class="ubi-debtors-list">
            ${debtorsList}
          </div>

          <div class="ubi-filter-action">
            <button type="button" class="btn-ubi-filter" onclick="filterByUbicacion('${g.title.replace(/'/g, "\\'")}')">
              <i class="ti ti-filter"></i> Filtrar asesores de este concepto
            </button>
          </div>
        </div>
      `;
    }).join('');
  }

  window.filterByUbicacion = function(ubiName) {
    filterUbi = ubiName;
    const banner = document.getElementById('ubi-filter-banner');
    const nameEl = document.getElementById('ubi-filter-name');
    if (banner && nameEl) {
      nameEl.textContent = ubiName;
      banner.style.display = 'flex';
    }
    renderAll();
    const c = document.getElementById('debtors-container');
    if (c) c.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  window.clearUbiFilter = function() {
    filterUbi = '';
    const banner = document.getElementById('ubi-filter-banner');
    if (banner) banner.style.display = 'none';
    renderAll();
  };

  /* ── RENDER COMPLETO ── */
  function renderAll() {
    const list = debtors.filter(d => {
      // 1. Búsqueda por texto (nombre / rol)
      if (filterText) {
        const hay = (d.name + ' ' + d.role).toLowerCase();
        if (!hay.includes(filterText)) return false;
      }

      // 2. Filtro por Rol
      if (filterRole) {
        if (!d.role.toLowerCase().includes(filterRole.toLowerCase())) return false;
      }

      // 3. Filtro por Ubicación activa seleccionada
      if (filterUbi) {
        const debUbis = extractDebtsFromDebtor(d);
        const matches = debUbis.some(u => 
          u.location.toLowerCase().includes(filterUbi.toLowerCase()) || 
          u.development.toLowerCase().includes(filterUbi.toLowerCase()) ||
          u.type.toLowerCase().includes(filterUbi.toLowerCase())
        );
        if (!matches) return false;
      }

      // 4. Filtro por Estado de cuenta
      const avail = d.comision + d.saldo;
      const net = avail - d.deuda;

      if (filterStatus === 'with-debt' && d.deuda <= 0) return false;
      if (filterStatus === 'with-positive' && avail <= 0) return false;
      if (filterStatus === 'can-adjust' && (avail <= 0 || d.deuda <= 0)) return false;
      if (filterStatus === 'net-negative' && net >= 0) return false;
      if (filterStatus === 'no-movements' && (d.deuda !== 0 || d.comision !== 0 || d.saldo !== 0)) return false;

      return true;
    });

    recalcTotals(list);

    if (list.length === 0) {
      document.getElementById('debtors-container').innerHTML = '<div class="state-msg"><i class="ti ti-users"></i>No hay asesores ni gerentes que coincidan con los filtros aplicados</div>';
      return;
    }
    const prev = new Set(expanded);
    document.getElementById('debtors-container').innerHTML = list.map(renderCard).join('');
    prev.forEach(id => {
      const card = document.getElementById('card-' + id);
      const panel = document.getElementById('panel-' + id);
      if (card && panel) { card.classList.add('expanded'); panel.classList.add('open'); }
    });
  }

  /* ── ESTRELLAS (Opcional, igual a comisiones) ── */
  function initStars() {
    const c = document.getElementById('stars');
    if(!c) return;
    for(let i=0; i<30; i++) {
      let s = document.createElement('div');
      s.className = 'star';
      s.style.width = s.style.height = (Math.random()*2 + 1) + 'px';
      s.style.left = Math.random()*100 + '%';
      s.style.top = Math.random()*100 + '%';
      s.style.background = 'rgba(96,230,26,'+ (Math.random()*0.5 + 0.2) +')';
      s.style.setProperty('--dur', (Math.random()*3 + 2) + 's');
      c.appendChild(s);
    }
  }

  /* ── INIT ── */
  document.getElementById('fecha-hoy').textContent =
    new Date().toLocaleDateString('es-MX', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
  
  loadCartera();
  initStars();

</script>
</body>
</html>
